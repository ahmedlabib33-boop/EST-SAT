# Database Configuration
DATABASE_URL=sqlite:///estsat.db
# For PostgreSQL: postgresql://user:password@localhost:5432/estsat

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production-min-32-chars!

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Application Configuration
APP_NAME=SAT 1 & EST 1 Study Platform
APP_VERSION=1.0.0

# AI coach and flashcards (optional). Without a key the coach page says it is not switched on.
GROQ_API_KEY=
# AI calls per student in any 24 hours. Teachers and admins are not counted.
AI_DAILY_LIMIT=150
